# ===== 登入（設定於 Vercel → Project Settings → Environment Variables，Production）=====

# 32+ 字元隨機密鑰（Secret）。產生方式：openssl rand -base64 32
AUTH_SECRET=

# 白名單（逗號分隔）：使用工作台的設計師與主管 Email
ALLOWED_EMAILS=

# resend.com API key（Secret，Sending access）
RESEND_API_KEY=

# 寄件位址。未驗證自有網域前只能寄給 Resend 帳號本人：onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# 正式網址（magic link 的 base URL）
APP_URL=https://pure-render-studio.vercel.app

# ===== 後台儲存（Vercel Blob，連線 store 時自動加入）=====
# BLOB_READ_WRITE_TOKEN=
# 管理者（可改金鑰與公司設定），逗號分隔；未設定時為 ALLOWED_EMAILS 的第一位
# ADMIN_EMAILS=

# ===== 本機開發／測試用（正式環境不要設）=====
# SETTINGS_STORE_DIR=./.data
# OPENAI_BASE_URL=http://localhost:3999/v1
# ANTHROPIC_BASE_URL=http://localhost:3999

# ===== AI 直接出圖：舊做法（建議改在工作台「設定」頁輸入）=====
# RENDER_LIVE=1
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=
# OPENAI_INPUT_FIDELITY=
